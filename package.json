{
  "name": "corelab-back",
  "version": "1.0.0",
  "description": "CoreLab LMS - Backend API",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "nodemon server/server.js",
    "dev:back": "nodemon server/server.js",
    "dev:front": "npm run dev --workspace=client",
    "dev:all": "concurrently \"npm run dev:back\" \"npm run dev:front\"",
    "test": "node --test tests/*.test.js"
  },
  "workspaces": [
    "client"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabrielrigaud/CoreLab.git"
  },
  "keywords": [],
  "author": "Gabriel Rigaud",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/gabrielrigaud/CoreLab/issues"
  },
  "homepage": "https://github.com/gabrielrigaud/CoreLab#readme",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "csv-parser": "^3.2.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mailtrap": "^4.6.0",
    "mongoose": "^9.6.3",
    "multer": "^2.1.1",
    "nodemailer": "^10.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "nodemon": "^3.1.0"
  }
}
